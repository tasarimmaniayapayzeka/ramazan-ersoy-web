# ============================================================
# Uzm. Dr. Ramazan Ersoy — drramazanersoy.tr (Linux cPanel / Apache)
# ------------------------------------------------------------
# NOT: HSTS satırı bilinçli olarak KAPALI bırakıldı. SSL kurulup
# site https üzerinden sorunsuz açıldıktan SONRA açın; erken
# açılırsa ve SSL sorun çıkarırsa site tarayıcıda kilitlenir.
# ============================================================

# ---------- Varsayılan dosya ----------
# TAM DEVİR (17 Ağu 2026): kök index.html kaldırıldı, / artık WP'nin
# front-page.php şablonundan döner. index.html hâlâ önde duruyor çünkü
# en/ dizini statik kaldı ve kendi index.html'ini servis etmeye devam
# ediyor.
DirectoryIndex index.html index.php

# 404: statik 404.html kaldırıldı; diskte olmayan her adres zaten WP
# geri-düşüşüne gider ve temanın 404.php şablonuyla döner.

# ---------- Yönlendirmeler ----------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS'e yönlendir
  #    Not: Cloudflare arkasında X-Forwarded-Proto kontrolü şart,
  #    yoksa sonsuz yönlendirme döngüsü oluşur.
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^(.*)$ https://drramazanersoy.tr/$1 [R=301,L]

  # 2) www'lu -> www'suz (canonical etiketleri www'suz kullanıyor)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]

  # 3) Klasör adresinde index.html'i göster (/alerji-rehberi/ gibi)
  #    Apache DirectoryIndex zaten yapar; ek kurala gerek yok.

  # 4) İÇERİK SAYFALARI WORDPRESS'E TAŞINDI (17 Ağu 2026, hibrit geçiş)
  #    Eski .html adresleri kalıcı olarak WP'nin dizin adreslerine gider.
  #    Liste BİLEREK sınırlı: testler/index.html ve alerji-rehberi/index.html
  #    statik kalır (pillar sayfalar), yalnız 21 içerik sayfası taşındı.
  #    Statik dosyalar diskte yedek olarak durur; bu kurallar dosya
  #    servisinden ÖNCE çalıştığı için ziyaretçi onları asla görmez.
  RewriteRule ^hastaliklar/(alerjik-rinit|astim|urtiker|besin-alerjisi|ilac-alerjisi|ari-alerjisi|herediter-anjiyoodem|mastositoz|anafilaksi)\.html$ /hastaliklar/$1/ [R=301,L]
  RewriteRule ^testler/(deri-prick-testi|spesifik-ige-kan-testi|solunum-fonksiyon-testi|yama-testi|provokasyon-testleri)\.html$ /testler/$1/ [R=301,L]
  RewriteRule ^tedaviler/(alerji-asisi-immunoterapi|alerji-asisi-sss)\.html$ /tedaviler/$1/ [R=301,L]
  RewriteRule ^alerji-rehberi/(ev-tozu-akari-yatak-odasi|evcil-hayvan-alerjisi|gebelikte-alerji-ve-astim|klima-ve-ic-ortam-alerjenleri|yetiskinlikte-baslayan-astim)\.html$ /alerji-rehberi/$1/ [R=301,L]

  # 4b) TAM DEVİR (17 Ağu 2026): kalan statik sayfalar da WP'ye taşındı.
  #     en/ İSTİSNA — İngilizce iskelet statik kaldı, adresleri değişmedi.
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteRule ^(basinda|cerez-politikasi|dr-ramazan-ersoy|iletisim|randevu|kvkk-aydinlatma|yasal-uyari|yayinlar-ve-oduller)\.html$ /$1/ [R=301,L]
  RewriteRule ^fiyatlar/alerji-testi-fiyatlari-2026\.html$ /alerji-testi-fiyatlari-2026/ [R=301,L]
  RewriteRule ^fiyatlar/?$ /alerji-testi-fiyatlari-2026/ [R=301,L]
  RewriteRule ^araclar/(alerji-mi-soguk-alginligi-mi|astim-kontrol-testi|polen-takvimi|video-kutuphanesi)\.html$ /araclar/$1/ [R=301,L]
  RewriteRule ^hasta-merkezi/(ikinci-gorus|online-on-degerlendirme|randevunuza-hazirlanin)\.html$ /hasta-merkezi/$1/ [R=301,L]
  RewriteRule ^testler/index\.html$ /testler/ [R=301,L]
  RewriteRule ^alerji-rehberi/index\.html$ /alerji-rehberi/ [R=301,L]

  # 4c) Yönetim kısayolu: kökten /wp-admin yazan doğrudan panele gitsin
  RewriteRule ^wp-admin(/.*)?$ /wp-yeni/wp-admin$1 [R=301,L]
  RewriteRule ^wp-login\.php$ /wp-yeni/wp-login.php [R=301,L]

  # 4d) Sitemap TEK kaynak: Yoast'ın adresi statik sitemap'e gitsin
  RewriteRule ^sitemap_index\.xml$ /sitemap.xml [R=301,L]

  # 4e) Kullanıcı adı taraması: ?author=N sızıntısını kes (yazar arşivi
  #     temada da 404; bu kural yönlendirme zincirini baştan keser)
  RewriteCond %{QUERY_STRING} (^|&)author=\d
  RewriteRule ^$ /? [R=301,L]

  # 5) ARŞİV KÖKLERİ WP'YE — geri-düşüşten ÖNCE gelmeli.
  #    hastaliklar/ ve tedaviler/ diskte GERÇEK klasör (yedek .html'ler
  #    içinde durur); aşağıdaki !-d koşulu bu yüzden onları yakalayamaz
  #    ve klasörde index.html olmadığı için 404 dönerdi. Oysa WP arşivi
  #    tam bu adreste yayın yapıyor ve kırıntılar oraya bağlanıyor.
  #    testler/ ve alerji-rehberi/ BİLEREK listede YOK: onların statik
  #    pillar index.html'leri var ve servis edilmeye devam ediyor.
  RewriteRule ^(hastaliklar|tedaviler)/?$ /index.php [L]

  # 6) WORDPRESS GERİ-DÜŞÜŞÜ — EN SONDA KALMALI.
  #    Diskte dosya ya da dizin olarak karşılığı OLMAYAN her adres kökteki
  #    index.php'ye (WP yükleyici) gider: /hastaliklar/astim/ WP'den döner,
  #    /randevu.html diskte var ve statik servis edilir. 404'ler artık
  #    WP temasının "İçerik bulunamadı" sayfasıyla döner.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

# ---------- Güvenlik başlıkları ----------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
  Header always unset X-Powered-By
  Header unset Server

  # HSTS — 26 Tem 2026'da KADEMELİ olarak açıldı (max-age=1 gün).
  # Ön koşullar doğrulandı: https 200, http→https ve www→non-www 301'leri
  # çalışıyor, AutoSSL etkin.
  # NEDEN 1 GÜN: HSTS tek yönlü kapıdır — tarayıcı süreyi hatırlar ve
  # sertifika yenilenmezse ziyaretçi siteye GİREMEZ (tıklayıp geçemez).
  # Site yeni yayında; bir hafta sorunsuz çalıştıktan sonra kademeli
  # olarak yükseltilecek: 86400 → 2592000 (1 ay) → 31536000 (1 yıl).
  # Geri alma: bu satırı yorum yapmak yetmez, süre dolana kadar beklenir
  # (test makinesinde: chrome://net-internals/#hsts ile temizlenir).
  # 17 Ağu 2026: 3 hafta sorunsuz — 1 güne yükseltilmişti, şimdi 1 AY.
  # Sonraki basamak (eylül ortası, yine sorunsuzsa): 31536000 (1 yıl).
  Header always set Strict-Transport-Security "max-age=2592000"
</IfModule>
ServerSignature Off

# ---------- Sıkıştırma ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript
  AddOutputFilterByType DEFLATE application/json image/svg+xml application/xml text/xml
</IfModule>

# ---------- Tarayıcı önbelleği ----------
<IfModule mod_expires.c>
  ExpiresActive On
  # HTML: kısa (içerik güncellemeleri hızlı görünsün)
  ExpiresByType text/html "access plus 1 hour"
  # Statik varlıklar: uzun
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/xml "access plus 1 day"
</IfModule>

# ---------- MIME tipleri ----------
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/svg+xml .svg
  AddType application/manifest+json .webmanifest
  AddCharset UTF-8 .html .css .js .json .xml .txt
</IfModule>

# ---------- Geliştirme dosyalarına erişimi engelle ----------
<FilesMatch "^(server\.js|build-sitemap\.js|yayin-paketi-olustur\.js|package(-lock)?\.json|\.gitignore|\.cpanel\.yml|.*\.md)$">
  Require all denied
</FilesMatch>

# ---------- Chatbot yapılandırması ----------
# chat-config.php OpenAI anahtarını tutar. PHP olarak çalıştığı için
# içeriği normalde dışarı sızmaz; ama PHP bir gün devre dışı kalırsa
# (modül hatası, yanlış handler) dosya DÜZ METİN olarak servis edilir
# ve anahtar açığa çıkar. Bu yüzden web erişimi tamamen kapatılıyor —
# chat-api.php dosyayı sunucu tarafında require ile okur, etkilenmez.
<FilesMatch "^chat-config(\.ornek)?\.php$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /\.claude
